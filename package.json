{
  "name": "sword-and-staff",
  "version": "1.0.0",
  "private": true,
  "description": "Isometric 1v1 medieval arena duel: Warrior vs Mage. Argentum Online classes, Battlerite pace.",
  "type": "module",
  "scripts": {
    "start": "node services/server/index.js",
    "share": "node scripts/share.mjs",
    "test": "node --test \"services/**/test/*.test.js\" \"scripts/test/*.test.js\"",
    "eval": "node evals/balance.mjs",
    "eval:net": "node evals/netcode.mjs",
    "build:edge": "node services/edge/build.mjs",
    "dev:edge": "wrangler dev -c services/edge/wrangler.toml",
    "deploy": "wrangler deploy -c services/edge/wrangler.toml",
    "logs:edge": "wrangler tail -c services/edge/wrangler.toml",
    "eval:edge": "node evals/edge.mjs"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "wrangler": "^4.139.0"
  }
}
